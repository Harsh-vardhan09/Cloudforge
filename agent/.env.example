# Where the ComputeGrid backend is reachable from this machine.
BACKEND_URL=http://localhost:5000

# Your host token. Copy it from the "Add GPU" page while signed in.
# Tokens expire after 7 days; when the agent logs a 401, paste a fresh one here.
AGENT_JWT_TOKEN=your_host_jwt_token_here

# Port this agent listens on. Must be reachable from the backend for GPU reclaim.
AGENT_PORT=7000

# What you charge renters, in USD per hour.
PRICE_PER_HOUR=0.5

# How often to report "I'm alive". The backend marks a GPU offline after 60s.
HEARTBEAT_INTERVAL=15

# How many jobs this machine will run at once.
MAX_CONCURRENT_JOBS=2

# Per-job Docker resource limits. Increase only if this host has spare capacity.
JOB_CPU_CORES=4
JOB_MEMORY_LIMIT=1g

# Reuse a local image for faster starts; set to "always" to refresh from registry.
DOCKER_IMAGE_PULL_POLICY=if-not-present

# How often a running job's CHECKPOINT_DIR is snapshotted (minimum 10).
CHECKPOINT_INTERVAL_SECONDS=60

DEBUG=false
